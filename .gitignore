# Python
__pycache__/
*.pyc
*.egg-info/
build/
dist/
# Built distributions. Ours are published to PyPI, not committed. Scoped to
# the build output dirs and the repo root rather than repo-wide, so a wheel
# deliberately added under a subdirectory is still visible to `git status`
# instead of being silently swallowed.
/dist/*.whl
/dist/*.tar.gz
/build/*.whl
/*.whl
/*.tar.gz
# uv is not a supported installer here: every HPC install in this repo runs
# `--no-deps` against the platform's own accelerator-aware torch. A lockfile
# left behind by a stray local `uv lock` would pin PyPI torch wheels that
# shadow that build (undefined symbol: __kmpc_fork_call), so it must never
# reach a commit.
uv.lock

# Conda
Miniconda3-latest-MacOSX-arm64.sh

# Documentation
site/

# Environment Variables
# .env holds real, site-specific paths and secrets and must never be tracked.
# Any .env.<site> variant is equally sensitive; only the sanitized *.template
# and *.example files are committed.
.env
.env.*
!.env*.template
!.env*.example
.venv/
.venv-deepspeed/

# Data
/data/

# Temporary Files
temp_nanochat/
PRISM_Report*
generate_report_html.py
outputs/
jobs/
globus_setup/
tmp/
tools/tmp/
tools/check_*.py
tools/debug_*.py
tools/inspect_*.py
tools/download_*.py
# ...but this one is tracked. Ruff honours .gitignore even for tracked files,
# so without the negation it is invisible to `ruff check ... tools` and its
# findings never reach CI.
!applications/vision_language/download_docci.py
tools/verify_*.py
tools/repair_*.py
tools/test_*.py
tools/fix_*.py
tools/audit_*.py
# visualization/ and viz_output/ are runtime-created by tools/universal_evaluator.py;
# ignore wherever they appear.
visualization/
viz_output/
error_*.txt
history_*.txt

# DS_Store
.DS_Store
docs/.DS_Store
docs/assets/.DS_Store 

