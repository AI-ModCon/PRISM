# User-Specific Configuration
# Copy this file to .env and update with your local paths and secrets
# generated by tools/launch_aurora.py

# Hugging Face Authentication
# Required for downloading gated models (e.g. Llama 3, StarCoder)
# Get your token from https://huggingface.co/settings/tokens
HF_TOKEN=""

#wandb Authentication
WANDB_API_KEY = ""

# Hugging Face Cache Directory
# Where models/datasets are stored locally or on shared Lustre filesystem
# Example: /flare/<project>/<your_username>
HF_HOME="/flare/<project>/<your_username>"

# PRISM Project Root
# Path to the base of the repository
PRISM_DIR="/flare/<project>/<your_username>/BaseMM_PRISM"

# Shared Hugging Face Hub (Optional but strongly recommended on Aurora)
# A shared directory containing pre-downloaded models to avoid re-downloading.
# This is the SOURCE the Aurora launchers copy from when staging models to
# /tmp on each compute node (see MODELS_TO_STAGE in tools/launch_aurora_*.py).
#
# Without this set correctly, the launcher falls back to ~/.cache/huggingface/hub
# which is often missing pytorch_model.bin / model.safetensors for models you
# haven't personally downloaded, producing offline-mode AttributeError crashes
# inside transformers (e.g. TapasModel.from_pretrained).
#
# Point this at whichever shared HF hub your team maintains, e.g.:
SHARED_HF_HOME="/flare/<project>/<your_username>/hub"

# Environment Tarball (only used if VENV_PATH is empty)
# Path to the packed conda environment for compute nodes
ENV_TARBALL="deepspeed_env.tar.gz"

# Virtual Environment Path (if set, skip tarball and use this venv directly)
# Set this to your shared venv path if you don't use tarball staging.
#
# Build it once on the UAN with:
#   VENV_PATH=/flare/ModCon/$USER/prism-envs/py3.12 bash tools/build_aurora_env.sh
#
# Then the Aurora launchers will source it directly when --use-shared-venv is
# passed (or VENV_PATH is set in this .env and supported by the launcher).
#
# Example: VENV_PATH="/flare/ModCon/$USER/prism-envs/py3.12"
VENV_PATH=""

# Site Paths (src/site_paths.py)
# ------------------------------------------------------------------
# Tracked configs under src/conf/ and src/data/ name these roots as
# ${PRISM_*} instead of one user's directories. src/site_paths.py resolves
# them from, in order: the process environment, the file named by
# PRISM_SITE_ENV, then this .env. Anything left unset expands to a
# "<unset:NAME>" placeholder so a config still parses, and any code about to
# touch the filesystem raises naming the variable to set.
#
# If your team keeps one file of real values outside the repository, point
# PRISM_SITE_ENV at it and leave the five below unset. See
# docs/platforms/site_paths.md.
# PRISM_SITE_ENV="/lus/flare/projects/<project>/prism-site.env"

# Hugging Face hub cache holding models--<org>--<name>/snapshots/<sha>.
# Usually the same directory as SHARED_HF_HOME above, plus "/hub" if
# SHARED_HF_HOME points at an HF_HOME rather than at a hub.
PRISM_HF_HUB="/flare/<project>/<your_username>/huggingface/hub"

# Root under which prepared WebDataset/Arrow shards live. Read by
# src/data/datasets_config.json and the Hydra data configs.
PRISM_DATA_ROOT="/flare/<project>/<your_username>/data"

# Interleaved tokenizers (two are committed under tokenizers/), referenced by the
# prism_olmo*_ts presets in src/conf/model/.
PRISM_TOKENIZERS="/flare/<project>/<your_username>/BaseMM_PRISM/tokenizers"

# Staged third-party generator assets, e.g. the pinned OmniGen2 snapshot used
# by the image-generation configs in src/conf/image_generation/.
PRISM_ASSETS="/flare/<project>/<your_username>/assets"

# Training outputs: checkpoints, run directories, and resume sources such as
# the Stage 1 projector named by src/conf/training/bioreason_sft.yaml.
PRISM_OUTPUT_ROOT="/flare/<project>/<your_username>/outputs"

# Model & Dataset Path Overrides (optional)
# These override placeholder defaults baked into src/config.py and
# src/encoders/geometry.py. Leave unset to use the placeholder paths — this
# is fine unless you're actually exercising the feature that needs them
# (VLA training, the AuroraGPT-2B preset, interleaved-TS OLMo presets, or
# the walrus geometry encoder's shared-hub fast path).

# CALVIN VLA dataset root (used when task=vla_calvin; see training.calvin_root
# in src/conf/training/zone_a.yaml)
# PRISM_CALVIN_ROOT="/flare/<project>/<your_username>/vla_training/calvin_dataset"

# AuroraGPT-2B checkpoint used as llm_backbone_id by the "prism-auroragpt-2b" preset
# PRISM_AURORAGPT_2B_CHECKPOINT="/lus/flare/projects/<project>/<path>/AuroraGPT-2B-checkpoint/global_stepNNNNNN"

# Custom OLMo tokenizer with interleaving tokens added, used as llm_tokenizer_id
# by the prism-olmo-*-interleaved presets. Build with
# the committed tokenizers/ directory, or point at your own path.
# PRISM_OLMO1B_INTERLEAVED_TOKENIZER="/flare/<project>/<your_username>/BaseMM_PRISM/tokenizers/prism-olmo-1b-interleaved"

# Shared HF hub snapshot of the walrus geometry encoder weights. When set and
# the file exists, src/encoders/geometry.py loads it directly instead of
# falling through to the HF download path.
# PRISM_WALRUS_WEIGHTS_PATH="/flare/<project>/<your_username>/hub/models--polymathic-ai--walrus/snapshots/<revision>/walrus.pt"

# Aurora Job Settings
# Default Project Allocation
PROJECT_ALLOCATION="ModCon"
# Default Queue (debug, workq, etc.)
QUEUE_NAME="debug"

# Proxy Settings (Aurora)
# Usually standard, but can be overridden if needed
PROXY_URL="http://proxy.alcf.anl.gov:3128"
NO_PROXY="admin,polaris-adminvm-01,localhost,*.cm.polaris.alcf.anl.gov,polaris-*,*.polaris.alcf.anl.gov,*.alcf.anl.gov"
