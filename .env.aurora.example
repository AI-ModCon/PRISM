# Site paths for ALCF Aurora — sanitized example.
#
# This file documents the SHAPE of a site-paths file. It is committed, so it
# must never contain a real project name, account name, or allocation path:
# every site-specific segment below is written as <placeholder>.
#
# Two ways to use it:
#
#   1. Per user — copy the assignments into the repository's own .env
#      (gitignored) with your real values substituted.
#
#   2. Per team — keep ONE file of real values in a shared, group-readable
#      directory OUTSIDE any git checkout, and point every member at it:
#
#          export PRISM_SITE_ENV=/lus/flare/projects/<project>/prism-site.env
#
#      Nothing in the repository ever learns the real paths; src/site_paths.py
#      reads them at load time. See docs/platforms/site_paths.md.
#
# Precedence is process environment > $PRISM_SITE_ENV file > repo .env, so a
# one-off run can override a single root without editing anything:
#
#     PRISM_DATA_ROOT=/tmp/$USER/shards prism train ...
#
# $USER and ${VAR} are expanded against the process environment when the file
# is read, which is what lets one shared team file serve every account.

# Hugging Face hub cache, containing models--<org>--<name>/snapshots/<sha>.
# The image-generation configs in src/conf/image_generation/ join a PINNED
# snapshot SHA onto this root, so it must be a hub directory, not an HF_HOME.
PRISM_HF_HUB="/lus/flare/projects/<project>/<user>/huggingface/hub"

# Root for prepared WebDataset/Arrow shards. Referenced by
# src/data/datasets_config.json, src/conf/data/lustre_datasets.yaml, and
# src/conf/data/vlm_diverse_global_shuffle_v1.yaml.
PRISM_DATA_ROOT="/lus/flare/projects/<project>/<user>/prism_data"

# Interleaved tokenizers. Two are committed under tokenizers/ in the repo;
# there is no builder script. Referenced by the
# prism_olmo*_ts presets in src/conf/model/.
PRISM_TOKENIZERS="/lus/flare/projects/<project>/<user>/BaseMM_PRISM/tokenizers"

# Staged third-party generator assets, e.g. the pinned OmniGen2 checkout used
# by src/conf/image_generation/*.json (which append "/OmniGen2").
PRISM_ASSETS="/lus/flare/projects/<project>/<user>/assets"

# Training outputs: run directories, checkpoints, and resume sources such as
# the Stage 1 projector named by src/conf/training/bioreason_sft.yaml.
PRISM_OUTPUT_ROOT="/lus/flare/projects/<project>/<user>/outputs"
