cd /lus/flare/projects/ModCon/sandeep/prism-docci-joint-20260921/prism
mpiexec -n 1 --ppn 1 --cpu-bind depth --depth 32 bash /lus/flare/projects/ModCon/sandeep/prism-docci-joint-20260921/jobs/pilot-100-01/worker.sh
