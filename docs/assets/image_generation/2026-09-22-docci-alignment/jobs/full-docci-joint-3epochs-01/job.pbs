set -eo pipefail
: "${PBS_JOBID:?Run via qsub}"
module use /soft/modulefiles
module load frameworks/2025.3.1
set -u
cd /lus/flare/projects/ModCon/sandeep/prism-docci-alignment-20260922/prism-joint-components
mpiexec -n 1 --ppn 1 --cpu-bind depth --depth 32 bash /lus/flare/projects/ModCon/sandeep/prism-docci-alignment-20260922/jobs/full-docci-joint-3epochs-01/worker.sh
