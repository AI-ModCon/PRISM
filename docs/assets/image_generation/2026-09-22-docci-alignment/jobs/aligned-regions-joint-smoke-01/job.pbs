module load frameworks/2025.3.1
set -u
cd /lus/flare/projects/ModCon/sandeep/prism-docci-alignment-20260922/prism-aligned-joint-smoke
mpiexec -n 1 --ppn 1 --cpu-bind depth --depth 32 bash /lus/flare/projects/ModCon/sandeep/prism-docci-alignment-20260922/jobs/aligned-regions-joint-smoke-01/worker.sh
